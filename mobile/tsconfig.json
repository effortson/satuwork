{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // @satuwork/core 的源码里 import 带 .ts 后缀（Node 24 直接跑它的单测要这样写），
    // 类型检查经过那些文件时要放行。
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
