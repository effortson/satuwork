{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satuwork",
  "version": "0.1.7",
  "identifier": "sg.dami.satuwork",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "runtime/**/*",
      "ui/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGODI1MENCQTVGMjAyNUMKUldSY0F2S2x5MUNDUDNydE5wTWhtTmpCWTcvYzlaVVh4WUoybGlabThocXB1MkNOZmc3WWF1TGgK",
      "endpoints": [
        "https://github.com/effortson/satuwork/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
