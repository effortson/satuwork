node_modules/
*.log
.DS_Store
.env
# 备份也要挡住。`.env` 这一条只挡住原名——而备份的名字（.env.bak-<时间戳>）是
# 手滑最容易留下的那一种，它带着平台 token 和数据库连接串，一个 `git add -A` 就上去了。
.env.bak-*
# `vercel link` / `vercel env pull` 落下的本地环境（VERCEL_OIDC_TOKEN 等）。
.env*.local
# `vercel env pull .env.production` 这种带环境名的落点：上面三条一条都挡不住它，而它里面
# 是 Neon 的生产连接串（带口令）。所以按前缀全挡，只放行示例文件。
.env.*
!.env.example
# 生成 JWT 钥匙的 openssl 命令默认写在当前目录（docs/vercel-deploy.md 那几行）；私钥落在
# 仓库根目录时 `git add -A` 一下就上去了。钥匙该在 ~/.satuwork-gateway/keys 或环境变量里。
*.pem

# 运行时数据，不进版本库
.satuwork/
.satuwork-gateway/

# 前端构建产物
ui/dist/
bot/ui/dist/

# bot/pack.mjs 打出来的发布包
dist/

# e2e 启动器临时改写的组合
bot/cordis.e2e.yml
bot/cordis.mounted.yml

# 本机运行时（Gateway/Bot 数据与密钥）
.data/

# 桌面壳（Rust 编译产物与 Tauri 生成的 schema）
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/runtime/*
!desktop/src-tauri/runtime/README.txt
# prepare-ui.mjs 从 gateway/ui 拷过来打包用；README.txt 留着让 tauri-build 的 resources 通配能命中
desktop/src-tauri/ui/*
!desktop/src-tauri/ui/README.txt

# gateway/scripts/build-vercel.mjs 打出来的 Build Output（vercel.json 的 buildCommand 现场生成）
.vercel/
