{
  "name": "satuwork-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "esbuild": "0.25.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
